# URL de la base PostgreSQL (sur le poste principal, accessible uniquement par le serveur)
SOMIDAC_DATABASE_URL=postgres://somidac:somidac_dev@127.0.0.1:5433/somidac
# Dossier des données du serveur (certificats, sauvegardes, secrets)
SOMIDAC_DATA_DIR=../../.dev/serveur
# Port HTTPS du serveur SOMIDAC
SOMIDAC_PORT=7443
